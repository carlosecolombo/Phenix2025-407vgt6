# Microchip XC8
export PATH="$PATH:/Applications/microchip/xc8/v2.46/bin"
export PATH="$PATH:/Applications/microchip/xc8/v3.00/bin"

# STM32 tools
export STM32_PRG_PATH="/Applications/ST/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/MacOS/bin"
export STM32CubeMX_PATH="/Applications/ST/ST.app/Contents/Resources"

# ARM GNU Toolchain (STM32)
export PATH="/Applications/ArmGNUToolchain/15.2.rel1/arm-none-eabi/bin:$PATH"


{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32 (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",

            "cwd": "${workspaceFolder}",
            "executable": "build/debug/Phenix2025-407VGT6.elf",

            "device": "STM32F407VGT6",
            "interface": "swd",

            "openOCDPath": "/Users/carlos/Library/Application Support/Code/User/globalStorage/bmd.stm32-for-vscode/@xpack-dev-tools/openocd/0.12.0-7.1/.content/bin/openocd",

            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],

            "runToEntryPoint": "main",
            "svdFile": "STM32F407.svd",

            "preLaunchTask": "Build STM32"
        }
    ]
}

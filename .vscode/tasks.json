{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build STM32",
      "type": "shell",
      "command": "make",
      "args": ["-j8"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean STM32",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
